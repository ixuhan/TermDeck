{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermDeck",
  "version": "0.3.2",
  "identifier": "as.ixuhan.termdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermDeck",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ixuhan/TermDeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNjEzNjM1NkM3QkEzMTcKUldRWG8zdHNOVFpodk5BS2NjMCtuYWFHZjluUTNEVEJ5LzNCSlRDWEVRZE9uWDJ5SDgveXNnc2MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
